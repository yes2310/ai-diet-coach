DATABASE_URL="postgresql://nutrition:nutrition@localhost:5432/nutrition_ai?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:9000"
AUTH_TRUST_HOST="true"
ADMIN_TOKEN="replace-with-a-long-random-admin-token"

# ChatMock local OpenAI-compatible server.
# Run: chatmock login && chatmock serve
CHATMOCK_BASE_URL="http://127.0.0.1:8000/v1"
CHATMOCK_API_KEY="anything"
CHATMOCK_MODEL="gpt-5.4-mini"

# Optional: customize the User-Agent sent to Open Food Facts product search.
OPEN_FOOD_FACTS_USER_AGENT="ai-diet-coach/0.1.0 (contact@example.com)"
