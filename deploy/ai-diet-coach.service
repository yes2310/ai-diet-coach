[Unit]
Description=AI Diet Coach Next.js service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ai-diet-coach
Environment=NODE_ENV=production
Environment=APP_HOST=0.0.0.0
Environment=APP_PORT=3000
ExecStart=/bin/bash /opt/ai-diet-coach/scripts/serve.sh
Restart=always
RestartSec=10
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
